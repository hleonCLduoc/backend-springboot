{
  "info": {
    "name": "Ferretería Los Maestros · EP3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Configurar adminPassword localmente antes de ejecutar. La colección crea un cliente y producto temporales, elimina ambos mediante la API y conserva el mensaje de contacto de prueba. No contiene credenciales reales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://ferreteria-backend-wlil.onrender.com",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@losmaestros.cl",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteRut",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientePassword",
      "value": "Prueba1234",
      "type": "string"
    },
    {
      "key": "productoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName.startsWith(\"01 \")) {",
          "  const base = String(70000000 + Math.floor(Math.random() * 9999999));",
          "  let suma = 0, factor = 2;",
          "  for (let i = base.length - 1; i >= 0; i--) { suma += Number(base[i]) * factor; factor = factor === 7 ? 2 : factor + 1; }",
          "  const n = 11 - suma % 11;",
          "  const dv = n === 11 ? \"0\" : n === 10 ? \"K\" : String(n);",
          "  pm.collectionVariables.set(\"clienteRut\", base + \"-\" + dv);",
          "  pm.collectionVariables.set(\"clienteEmail\", \"ep3-\" + Date.now() + \"@example.com\");",
          "  pm.collectionVariables.set(\"productoId\", \"QA-\" + Date.now());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Catálogo público",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Registro público",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/registrar",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Prueba\",\n  \"email\": \"{{clienteEmail}}\",\n  \"rut\": \"{{clienteRut}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"clienteId\", pm.response.json().datos.id);"
            ]
          }
        }
      ]
    },
